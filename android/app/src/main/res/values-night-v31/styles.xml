<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Same override as values-v31, kept in sync because the app's theme
         (Papier/Encre/N&B) is chosen inside the app, not tied to the
         system's dark-mode setting — the native pre-Flutter splash should
         look the same regardless of the device's night mode. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
    </style>
</resources>
